              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var respuesta = pm.response.json();\nif (pm.response.code === 200) {\n    if (respuesta.datos && respuesta.datos.token) {\n        // Usamos un nombre único para este proyecto\n        pm.collectionVariables.set(\"tp2_token\", respuesta.datos.token);\n        console.log(\"¡Token guardado como tp2_token!\");\n    }\n}"
                ]
