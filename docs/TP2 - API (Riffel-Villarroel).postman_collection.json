    {
      "name": "Usuarios (Admin)",
      "description": "CRUD administrativo de usuarios y médicos. Requiere rol administrador. Las mutaciones quedan registradas en log_auditoria (entidad usuario).",
      "item": [
        {
          "name": "Listar todos los usuarios",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tp2_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tp2_token}}",
                "type": "text"
              }
            ],
            "description": "Acceso: exclusivo rol \"administrador\".\n\nParámetros esperados: ninguno (sin body ni query).\n\nRespuesta esperada: formato { codigo, estado, datos }. 200: { \"codigo\": 200, \"estado\": \"ok\", \"datos\": { \"usuarios\": [ { \"id\": number, \"nombre\": string, \"apellido\": string, \"email\": string, \"rol\": string, \"id_cobertura\": number|null, \"id_sede\": number|null } ] } }. 401/403 si el token falta o el rol no es administrador.",
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Crear usuario/médico",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tp2_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tp2_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "description": "Acceso: exclusivo rol \"administrador\". Audita ALTA sobre entidad usuario.\n\nParámetros esperados (Body JSON): nombre (string), apellido (string), dni (string/number, requerido), fecha_nacimiento (string YYYY-MM-DD, opcional), email (string), password (string), rol (string: paciente|medico|operador|administrador), id_cobertura (number|null), id_sede (number|null).\n\nRespuesta esperada: formato { codigo, estado, datos }. 201: { \"codigo\": 201, \"estado\": \"ok\", \"datos\": { \"mensaje\": \"Usuario creado exitosamente\" } }.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Laura\",\n    \"apellido\": \"Gómez\",\n    \"dni\": \"30111222\",\n    \"fecha_nacimiento\": \"1988-04-12\",\n    \"email\": \"laura.gomez@ejemplo.com\",\n    \"password\": \"1234\",\n    \"rol\": \"medico\",\n    \"id_cobertura\": null,\n    \"id_sede\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Modificar datos de usuario",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tp2_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tp2_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "description": "Acceso: exclusivo rol \"administrador\". Audita MODIFICACION sobre entidad usuario.\n\nParámetros esperados: path id (number). Body JSON: nombre (string), apellido (string), dni (string/number), fecha_nacimiento (string YYYY-MM-DD|null), email (string), rol (string), id_cobertura (number|null), id_sede (number|null). No actualiza password.\n\nRespuesta esperada: formato { codigo, estado, datos }. 200: { \"codigo\": 200, \"estado\": \"ok\", \"datos\": { \"mensaje\": \"Usuario modificado exitosamente\" } }.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Laura\",\n    \"apellido\": \"Gómez\",\n    \"dni\": \"30111222\",\n    \"fecha_nacimiento\": \"1988-04-12\",\n    \"email\": \"laura.gomez@ejemplo.com\",\n    \"rol\": \"medico\",\n    \"id_cobertura\": null,\n    \"id_sede\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
